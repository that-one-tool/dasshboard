{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "DaSSHboard",
	"version": "1.5.0",
	"identifier": "com.dasshboard.app",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "DaSSHboard",
				"width": 1280,
				"height": 1024,
				"minWidth": 960,
				"minHeight": 640
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"publisher": "That one tool",
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"endpoints": ["https://cdn.crabnebula.app/update/that-one-tool/dasshboard/{{target}}-{{arch}}/{{current_version}}"],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2QUEzNzNDNzA4REYzMzEKUldReDg0MXdQRGVxVnNuOHI4ck5BTy91THdJOE0zMnR5bFhMbm9zcjl2RXFZNThHV2NHUmgvS2wK"
		}
	}
}

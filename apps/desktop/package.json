{
	"name": "dasshboard",
	"author": {
		"name": "That one tool"
	},
	"private": true,
	"version": "1.40.7",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"lint": "eslint .",
		"check": "tsc --noEmit && eslint . && vitest run --coverage && cd src-tauri && cargo fmt --check && cargo test && cargo clippy --all-targets -- -D warnings"
	},
	"dependencies": {
		"@tauri-apps/api": "2.12.4",
		"@tauri-apps/plugin-dialog": "2.8.4",
		"@tauri-apps/plugin-opener": "2.7.2",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/addon-search": "0.16.0",
		"@xterm/addon-unicode11": "0.9.0",
		"@xterm/addon-web-links": "0.12.0",
		"@xterm/xterm": "6.0.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@tauri-apps/cli": "2.12.4",
		"@vitest/coverage-v8": "5.1.0",
		"eslint": "10.14.0",
		"happy-dom": "21.0.4",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.7",
		"vitest": "5.1.0"
	}
}

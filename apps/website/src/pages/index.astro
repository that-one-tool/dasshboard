---
import Layout from "../layouts/Layout.astro";
import appIcon from "../assets/app-icon.svg";
import { readAppVersion } from "../lib/appVersion";
import { downloadInfo } from "../lib/downloads";

const download = downloadInfo(readAppVersion());
const repoUrl = "https://github.com/that-one-tool/dasshboard";

const features = [
	{
		title: "Live terminal grid",
		body: "Arrange several live terminals in a grid — 1×1 up to 3×2 presets with draggable splitters — and keep independent workspaces open as tabs.",
	},
	{
		title: "SSH, serial & local shells",
		body: "One address book for SSH hosts, serial/COM ports and local PowerShell, bash or zsh sessions, with tags and instant search.",
	},
	{
		title: "Local-only by design",
		body: "No account, no cloud, no telemetry. The app only connects to the hosts you open; your devices, profiles and settings are plain files on your machine.",
	},
	{
		title: "Secrets & host keys, guarded",
		body: "Passwords and passphrases live only in the OS keychain, never in a file or export. Host keys are pinned on first connect; a changed key needs your explicit approval.",
	},
	{
		title: "Tunnels & jump hosts",
		body: "Local port forwarding (ssh -L) with start/stop from the sidebar, ProxyJump through a saved bastion, and opt-in agent forwarding.",
	},
	{
		title: "SFTP file browser",
		body: "A docked Files panel with streamed uploads and downloads, a background transfer queue, bookmarks, sorting, filtering and chmod.",
	},
	{
		title: "One-click workspaces",
		body: "Save a layout as a profile, set a default, and reload the whole workspace — every pane reconnected — with a single click.",
	},
	{
		title: "Made to live in",
		body: "Auto-reconnect with backoff, keepalives, commands on connect, broadcast input, dark and light themes, and a UI in 7 languages.",
	},
];

const panes = [
	{ host: "web-01", lines: ["$ uptime", " 21:04  up 41 days,  load: 0.12"] },
	{ host: "db-primary", lines: ["$ systemctl is-active postgresql", "active"] },
	{ host: "COM3 · 115200", lines: ["router> show version", "IOS 17.9.4a"] },
	{ host: "local · pwsh", lines: ["PS> git status", "nothing to commit"] },
];
---

<Layout
	title="DaSSHboard — a desktop dashboard for your SSH devices"
	description="Save your devices once, arrange live terminals in a grid, and reload the whole workspace with a click. Free desktop app for Windows and Linux."
>
	<header class="topbar">
		<div class="container topbar-inner">
			<a class="brand" href={import.meta.env.BASE_URL}>
				<img src={appIcon.src} alt="" width="28" height="28" />
				DaSSHboard
			</a>
			<nav class="topnav">
				<a href="#features">Features</a>
				<a href="#download">Download</a>
				<a href={repoUrl}>GitHub</a>
			</nav>
		</div>
	</header>

	<main>
		<section class="hero container">
			<div class="hero-copy">
				<p class="eyebrow">v{download.version} · Windows &amp; Linux</p>
				<h1>Your SSH devices, one dashboard.</h1>
				<p class="lede">
					Save your devices once, arrange live terminals in a grid, and reload the whole workspace
					with a click.
				</p>
				<p class="local-note">
					No account, no cloud, no telemetry — nothing is sent anywhere but the hosts you connect to.
				</p>
				<div class="actions">
					<a class="btn btn-primary" href={download.installersUrl}>Download v{download.version}</a>
					<a class="btn" href={repoUrl}>View on GitHub</a>
				</div>
			</div>

			<div class="mock" aria-hidden="true">
				<div class="mock-bar"><span></span><span></span><span></span></div>
				<div class="mock-grid">
					{
						panes.map((pane) => (
							<div class="mock-pane">
								<div class="mock-host">
									<i class="dot" />
									{pane.host}
								</div>
								{pane.lines.map((line) => <div class="mock-line">{line}</div>)}
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section id="features" class="features container">
			<h2>Everything a terminal-heavy day needs</h2>
			<div class="feature-grid">
				{
					features.map((feature) => (
						<article class="feature">
							<h3>{feature.title}</h3>
							<p>{feature.body}</p>
						</article>
					))
				}
			</div>
		</section>

		<section id="download" class="download container">
			<div class="download-card">
				<img src={appIcon.src} alt="" width="64" height="64" />
				<div class="download-copy">
					<h2>Download DaSSHboard {download.version}</h2>
					<p>
						Installers for Windows (MSI and setup .exe) and Linux (.deb and .rpm).
					</p>
				</div>
				<div class="actions">
					<a class="btn btn-primary" href={download.installersUrl}>Get the installers</a>
					<a class="btn" href={download.releaseNotesUrl}>Release notes</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="footer container">
		<span>DaSSHboard — built with Tauri, Rust and xterm.js.</span>
		<a href={repoUrl}>Source on GitHub</a>
	</footer>
</Layout>

<style>
	.topbar {
		border-bottom: 1px solid var(--border);
		background: var(--surface-1);
	}

	.topbar-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		height: 60px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-weight: 700;
		color: var(--text-bright);
	}

	.topnav {
		display: flex;
		gap: 20px;
		font-size: 0.95rem;
	}

	.topnav a {
		color: var(--text-secondary);
	}

	.topnav a:hover {
		color: var(--text-bright);
	}

	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 48px;
		align-items: center;
		padding-top: 72px;
		padding-bottom: 72px;
	}

	.eyebrow {
		display: inline-block;
		margin: 0 0 16px;
		padding: 4px 12px;
		border-radius: var(--radius-pill);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent);
		background: var(--accent-soft);
	}

	h1 {
		margin: 0 0 16px;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--text-bright);
	}

	.lede {
		margin: 0 0 12px;
		font-size: 1.15rem;
		color: var(--text-secondary);
	}

	.local-note {
		margin: 0 0 28px;
		font-weight: 600;
		color: var(--text-primary);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.mock {
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-lg);
		background: var(--surface-1);
		overflow: hidden;
	}

	.mock-bar {
		display: flex;
		gap: 6px;
		padding: 10px 12px;
		border-bottom: 1px solid var(--border);
	}

	.mock-bar span {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--border-strong);
	}

	.mock-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
		padding: 8px;
	}

	.mock-pane {
		min-height: 110px;
		padding: 10px 12px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-family: var(--mono-font);
		font-size: 0.78rem;
		color: var(--text-secondary);
		background: var(--surface-0);
		overflow: hidden;
	}

	.mock-host {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-bottom: 8px;
		color: var(--text-primary);
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--ok);
	}

	.mock-line {
		white-space: pre;
	}

	.features {
		padding-top: 24px;
		padding-bottom: 72px;
	}

	h2 {
		margin: 0 0 28px;
		font-size: 1.7rem;
		letter-spacing: -0.01em;
		color: var(--text-bright);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 16px;
	}

	.feature {
		padding: 20px;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface-1);
	}

	.feature h3 {
		margin: 0 0 8px;
		font-size: 1.02rem;
		color: var(--text-bright);
	}

	.feature p {
		margin: 0;
		font-size: 0.95rem;
		color: var(--text-secondary);
	}

	.download {
		padding-bottom: 72px;
	}

	.download-card {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 24px;
		padding: 28px;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-lg);
		background: var(--surface-1);
	}

	.download-copy {
		flex: 1 1 280px;
	}

	.download-copy h2 {
		margin-bottom: 6px;
		font-size: 1.4rem;
	}

	.download-copy p {
		margin: 0;
		color: var(--text-secondary);
	}

	.footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 12px;
		padding-top: 24px;
		padding-bottom: 32px;
		border-top: 1px solid var(--border);
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 36px;
			padding-top: 48px;
			padding-bottom: 48px;
		}

		.topnav a:not(:last-child) {
			display: none;
		}
	}
</style>

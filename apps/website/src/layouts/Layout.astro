---
import "../styles/global.css";
import appIcon from "../assets/app-icon.svg";
import { DEFAULT_LOCALE, HTML_LANG, SUPPORTED_LOCALES, localePath, type Locale } from "../i18n/locales";

interface Props {
	title: string;
	description: string;
	locale: Locale;
}

const { title, description, locale } = Astro.props;
const absoluteUrl = (target: Locale) => new URL(localePath(target, import.meta.env.BASE_URL), Astro.site).href;
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="dark light" />
		<link rel="icon" type="image/svg+xml" href={appIcon.src} />
		<link rel="canonical" href={absoluteUrl(locale)} />
		{SUPPORTED_LOCALES.map((alternate) => <link rel="alternate" hreflang={HTML_LANG[alternate]} href={absoluteUrl(alternate)} />)}
		<link rel="alternate" hreflang="x-default" href={absoluteUrl(DEFAULT_LOCALE)} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

---
import MockPane from "./MockPane.astro";

const command = "$ uname -r";
const hosts = ["web-01", "web-02", "web-03"];
---

<div class="broadcast">
	<div class="toolbar">
		<span class="badge">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M12 12h.01M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7M5.6 5.6a9 9 0 0 0 0 12.8M18.4 5.6a9 9 0 0 1 0 12.8"></path>
			</svg>
			×3
		</span>
	</div>
	<div class="panes">
		{hosts.map((host) => <MockPane host={host} lines={[command, "6.8.0-45-generic"]} highlighted compact />)}
	</div>
</div>

<style>
	.broadcast {
		padding: 0.5rem;
	}

	.toolbar {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 0.5rem;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.2rem 0.6rem;
		border-radius: var(--radius-pill);
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--on-accent);
		background: var(--accent);
	}

	.badge svg {
		width: 0.9rem;
		height: 0.9rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}

	.panes {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.375rem;
	}
</style>

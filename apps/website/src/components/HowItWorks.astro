---
import type { SiteMessages } from "../i18n/en";

interface Props {
	t: SiteMessages;
}

const { t } = Astro.props;
---

<section id="how-it-works" class="section container">
	<h2 class="section-title">{t.howItWorks.title}</h2>
	<p class="section-lede">{t.howItWorks.lede}</p>
	<ol class="steps">
		{
			t.howItWorks.steps.map((step, index) => (
				<li class="step">
					<span class="step-number" aria-hidden="true">
						{index + 1}
					</span>
					<h3>{step.title}</h3>
					<p>{step.body}</p>
				</li>
			))
		}
	</ol>
</section>

<style>
	.steps {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.step h3 {
		margin: 0.875rem 0 0.5rem;
		font-size: 1.1rem;
		color: var(--text-bright);
	}

	.step p {
		margin: 0;
		color: var(--text-secondary);
	}

	.step-number {
		display: inline-grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		font-weight: 700;
		color: var(--on-accent);
		background: var(--accent);
	}
</style>
